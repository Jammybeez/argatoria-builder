// Prisma schema for Better Auth
// learn more: https://better-auth.com/docs/concepts/database

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// NOTE: When using mysql or sqlserver, uncomment the //@db.Text annotations in model Account below
// Further reading:
// https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String //@db.Text
  email         String
  emailVerified Boolean   @default(false)
  image         String? //@db.Text
  // Discord's profile accent color (hex, e.g. "#5865f2"), used for a border
  // glow next to the avatar. Null for Google sign-ins and Discord users who
  // haven't set one.
  accentColor   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  armies        Army[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String? //@db.Text
  userAgent String? //@db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String //@db.Text
  providerId            String //@db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String? //@db.Text
  refreshToken          String? //@db.Text
  idToken               String? //@db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String? //@db.Text
  password              String? //@db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String //@db.Text
  value      String //@db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

// ---------------------------------------------------------------------------
// Argatoria game data
// ---------------------------------------------------------------------------

enum UnitCategory {
  BASIC
  ELITE
  RARE
  UNIQUE
  HERO
  MERCENARY
}

// PER_BASE: pointsCost is multiplied by the number of bases/models chosen.
// FLAT: the unit is a single model at a fixed cost, quantity is always 1.
enum CostType {
  PER_BASE
  FLAT
}

// Sub-type for HERO-category units, used by army composition rules
// (min heroes, exactly-one-General, Command Group / Champion / Mage caps).
// Meaningless for non-HERO units, where it stays OTHER.
enum HeroType {
  GENERAL
  COMMAND_GROUP
  CHAMPION
  MAGE
  LEGENDARY_HERO
  OTHER
}

model Faction {
  id                  String @id @default(cuid())
  name                String @unique
  tagline             String?
  armySpecialRuleName String?
  armySpecialRuleText String?

  // Marks the single dummy "Appendix" faction row used to hold appendix
  // units (see AppendixEligibility). Excluded from the normal army-creation
  // faction picker; never chosen as an Army's own faction.
  isAppendix Boolean @default(false)

  units                Unit[]
  armies               Army[]
  appendixEligibilities AppendixEligibility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Unit {
  id        String @id @default(cuid())
  factionId String
  faction   Faction @relation(fields: [factionId], references: [id], onDelete: Cascade)

  name       String
  category   UnitCategory
  costType   CostType
  pointsCost Int
  minBases   Int? // default/minimum bases per unit instance, for PER_BASE units
  maxBases   Int? // max bases per unit instance, for PER_BASE units
  heroType   HeroType @default(OTHER) // only meaningful when category is HERO

  // This unit can only be added to an army if units with ALL of these exact
  // names are already in the roster (e.g. Truhlaks (Skeletons) requires the
  // General "Lord Necromancer"; Ghosts requires both the General "Lord
  // Necromancer" and the Champion "Champion of Ghosts"). Not restricted to
  // Generals. Empty array = no requirement.
  requiresHeroNames String[] @default([])

  // At least one of these must be present, in addition to (not instead of)
  // requiresHeroNames, e.g. Northern Guard Heroes need Dirandis fielding
  // Sasquatches OR Northern Guard (either is enough). Empty = no such
  // requirement.
  requiresAnyHeroNames String[] @default([])

  // Requires this exact upgrade to have been bought somewhere in the army
  // (e.g. Heroes of Avantur need Banner of Avantur purchased) — gated on a
  // purchase, not a unit's presence. Null = no such requirement.
  requiresUpgradeName String?

  // Grants Mage upgrade access (and counts toward the Mage cap) on top of
  // whatever this unit's own heroType already grants, e.g. Kor'quixos is a
  // Legendary Hero who is also explicitly a Mage.
  grantsMageUpgrades Boolean @default(false)

  // Hidden from the catalog behind the "Use appendix units" toggle even
  // though this unit belongs to a single faction (factionId isn't the
  // dummy Appendix faction) — for heroes restricted to "a certain army"
  // per the original appendix-unit definition, e.g. Xan'toag (Arox only)
  // or Gnat (Sheol-morg led by Lord Necromancer). Units eligible via
  // AppendixEligibility are always treated as appendix regardless of this
  // flag; pre-existing same-faction conditional units (e.g. Truhlaks)
  // stay visible by default and should NOT set this.
  appendixOnly Boolean @default(false)

  // This unit's normal `category` is overridden to `recategorizeToCategory`
  // (for composition-rule counting and catalog/roster grouping) whenever a
  // GENERAL with name `recategorizeGeneralName` is in the roster, e.g. Horned
  // Warriors is normally ELITE but counts as BASIC under Lord of the Abyss.
  // The unit is still purchasable at its normal category otherwise.
  recategorizeGeneralName String?
  recategorizeToCategory  UnitCategory?

  // Scaling per-army cap on how many instances of this specific unit are
  // allowed, distinct from the hero-type-wide caps (Mage/Legendary Hero):
  // max count = floor(pointsLimit / maxPerPoints), e.g. Rotgant's "max 1
  // model per every full 1000 army points" is maxPerPoints: 1000. Null =
  // no such cap. Shown as an advisory composition issue, same as every
  // other composition limit in the app (not a hard block on adding it).
  maxPerPoints Int?

  // Flat, non-scaling version of the above (e.g. Ghosts: "max 1 unit in the
  // army" regardless of points). If both this and maxPerPoints are set, the
  // more restrictive of the two applies.
  maxCount Int?

  // Exempts this unit from the "16 bases grants a free Marauders unit" rule
  // even though it may reach maxBases (e.g. Ghosts, a fixed 16-base unit
  // whose own text says "Marauders rule does not apply").
  disableMarauders Boolean @default(false)

  // stat line
  ld Int?
  m  Int?
  ws Int?
  s  Int?
  t  Int?
  a  Int?
  w  Int?

  specialRules          UnitSpecialRule[]
  armyUnits             ArmyUnit[]
  appendixEligibilities AppendixEligibility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([factionId])
}

// Cross-faction availability for appendix units — units that live outside
// any single faction's normal roster (see Unit.factionId, which points at a
// dummy "Appendix" Faction row for these) but can be taken by one or more
// real factions, sometimes only under a specific General. One row per
// (unit, faction) that's allowed to take it.
model AppendixEligibility {
  id        String @id @default(cuid())
  unitId    String
  unit      Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  factionId String
  faction   Faction @relation(fields: [factionId], references: [id], onDelete: Cascade)

  // Empty array = eligible under any General of this faction. Otherwise,
  // units with ALL these exact names (e.g. a General and a specific
  // Champion) must already be in the roster — enforced the same way
  // Unit.requiresHeroNames already is.
  requiresGeneralNames String[] @default([])

  // At least one of these must be present, in addition to (not instead of)
  // requiresGeneralNames — mirrors Unit.requiresAnyHeroNames.
  requiresAnyGeneralNames String[] @default([])

  // Requires this exact upgrade to have been bought somewhere in the army —
  // mirrors Unit.requiresUpgradeName, but per-faction since eligibility
  // itself is per-faction.
  requiresUpgradeName String?

  // Overrides the unit's normal pointsCost specifically for this faction
  // (e.g. Bristles (Knuroses) costs 15pts/base normally, 14pts/base in the
  // Vaendral army). Null = use the unit's own pointsCost as-is.
  costOverride Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, factionId])
  @@index([unitId])
  @@index([factionId])
}

model UnitSpecialRule {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  name String
  text String

  @@index([unitId])
}

model Army {
  id          String @id @default(cuid())
  name        String
  pointsLimit Int

  factionId String
  faction   Faction @relation(fields: [factionId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  units ArmyUnit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ArmyUnit {
  id     String @id @default(cuid())
  armyId String
  army   Army   @relation(fields: [armyId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])

  quantity Int    @default(1)
  sortOrder Int   @default(0)

  upgrades ArmyUnitUpgrade[]

  createdAt DateTime @default(now())

  @@index([armyId])
}

// Banner / Spell / Magic Item / Artefact — bought for HERO-category units.
// Eligibility by hero sub-type: BANNER -> Command Group, SPELL & MAGIC_ITEM
// -> Mage, ARTEFACT -> General.
enum UpgradeType {
  BANNER
  SPELL
  MAGIC_ITEM
  ARTEFACT
}

model Upgrade {
  id         String      @id @default(cuid())
  type       UpgradeType
  name       String
  pointsCost Int

  // Spells only: casting range in cm, and the Magic Test target (D6 roll
  // must be <= this to succeed).
  range        Int?
  castingValue Int?

  // Empty array = usable by any faction. Some items are restricted to one
  // or more factions (e.g. the Sheol-morg-only Banner of God Seth, or
  // Banner of Avantur for Vaendral/Dirandis/Gaeldor).
  factionNames String[] @default([])

  // Null = any eligible hero (of the right sub-type) can buy it. Set = only
  // a hero with this exact unit name can take it, e.g. Spellweaver's
  // Toughening and Drowsiness spells aren't available to any other Mage.
  restrictedToUnitName String?

  // Free-text conditions too specific/bespoke to model structurally (e.g.
  // "Sheol-morg, General other than Lord Necromancer only"). Shown as a
  // caveat in the picker but not enforced.
  requirementsText String?
  effectText       String

  armyUnitUpgrades ArmyUnitUpgrade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

model ArmyUnitUpgrade {
  id         String   @id @default(cuid())
  armyUnitId String
  armyUnit   ArmyUnit @relation(fields: [armyUnitId], references: [id], onDelete: Cascade)

  upgradeId String
  upgrade   Upgrade @relation(fields: [upgradeId], references: [id])

  createdAt DateTime @default(now())

  @@index([armyUnitId])
  @@index([upgradeId])
}
